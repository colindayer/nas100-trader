logs/
data/
# EVIDENCE IS IGNORED EVERYWHERE, ON PURPOSE.
# It is published by ONE producer -- the VPS -- using an explicit `git add -f` in
# desk_orchestrator.sync(). Earlier this used '!data/logs/'-style negations so the paths were
# trackable; that re-included them for EVERY clone, and a plain `git add -A` on a developer
# machine then published an EMPTY trades.jsonl and a test-polluted event log over the live
# record. .git/info/exclude cannot save you: a .gitignore negation outranks it.
# Ignore + force-add is the only arrangement where the wrong machine cannot publish evidence.
*.bi5
*.parquet
logs/btc_state.json
btcusdt_1h.csv
ethusdt_1h.csv
RD-Agent/

optionsdx/
*_7y.csv
*.txt
!requirements.txt
.DS_Store
dashboard/streamlit*.log
desktop/dist/
desktop/launcher.log

# live evidence (private repo only)
reports/
daily/
*-live-evidence*/
