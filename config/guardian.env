# prop_risk_guardian config.
# INITIAL_BALANCE MUST match the connected account: every limit below is a percentage of it.
# guardian_bridge fails closed if it disagrees with the broker balance by more than 2%.
# Bound to FTMO-Demo 1514166963 ($100,000). Change BOTH this file and the account together.
ACCOUNT_LOGIN=1514166963
INITIAL_BALANCE=100000
CHALLENGE_TARGET_PCT=10
PROP_MAX_DAILY_LOSS_PCT=5
PROP_MAX_TOTAL_LOSS_PCT=10
INTERNAL_DAILY_STOP_PCT=1.0
INTERNAL_TOTAL_STOP_PCT=3.0
MAX_OPEN_RISK_PCT=0.50
MAX_RISK_PER_TRADE_PCT=0.25
MAX_CORRELATED_RISK_PCT=0.50
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_HOURS=24
STALE_SECONDS=60
